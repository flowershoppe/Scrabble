id: victory
file_type: screen

import:
  - ../Templates/

  - /YUI/Animations/transitions.yui
  - /YUI/Widgets/

root:
  type: panel
  layout: canvas
  elements:
    - type: panel
      alignment: center
      theme: elektra light
      layout: canvas
      canvas:
        center: true
      background: ~spPanel
      size: {w: 1000, h: 800}
      elements:
        - type: panel
          canvas:
            top: 100
          size: {w: 700, h: 700}
          elements:
            - type: image
              sprite: ~spWinner
        - type: panel
          canvas:
            right: 75
            center: v
          elements:
            - type: text
              text: FINAL RESULT
            - type: text
              text: @@ 'Total Score | ' + @total_score
            - type: text
              text: @@ 'Largest Play | ' + @largest_play
            - type: text
              text: @@ 'Largest Word | ' + @largest_word
            - type: text
              text: @@ 'Words Spelled | ' + @words_spelled
            - type: text
              text: @@ 'Run Length | ' + @length
        - type: button
          theme: elektra
          background: ~spButton
          canvas: 
            bottom: 100
            center: h
          content:
            type: text
            text: Main Menu
            text_style: subtitle
          border_thickness: 0
          on_click: 
            - ~goto_mainmenu()
            - ~audio_play_sound_on(~oGame.emitter_SE, ~sdSelect, false, 1)
      

        
