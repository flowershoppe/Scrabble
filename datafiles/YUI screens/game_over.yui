id: game over
file_type: screen

import:
  - ../Templates/

  - /YUI/Animations/transitions.yui
  - /YUI/Widgets/

root:
  type: panel
  layout: canvas

  elements:
    - type: panel
      alignment: center
      canvas:
        center: true
      background: ~spPanel
      size: {w: 450, h: 600}
      padding: 20
      theme: elektra light
      elements:
        - type: image
          sprite: ~spLoser
          size: 256
        - type: text
          text: @@ 'Total Score - ' + @total_score
        - type: text
          text: @@ 'Largest Play - ' + @largest_play
        - type: text
          text: @@ 'Largest Word - ' + @largest_word
        - type: text
          text: @@ 'Words Spelled - ' + @words_spelled
        - type: button
          background: ~spButton
          theme: elektra
          content:
            type: text
            text: Main Menu
            text_style: subtitle
          border_thickness: 0
          on_click: 
            - ~goto_mainmenu()
            - ~audio_play_sound_on(~oGame.emitter_SE, ~sdBack, false, 1)
      

        
