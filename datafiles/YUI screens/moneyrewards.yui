id: moneyrewards
file_type: screen

import:
  - ../Templates/

  - /YUI/Animations/transitions.yui
  - /YUI/Widgets/

root:
  type: panel
  layout: canvas 
  elements:
    - type: panel
      layout: vertical
      alignment: center
      indexed: true
      theme: elektra light
      background: ~spPanel
      size: {h: 250, w: 900}
      padding: 30
      canvas:
        top: 750
        center: h
      elements:
        - type: panel
          layout: horizontal 
          animate:
            on_visible:
              opacity: &cascade_fade_in
          elements:
            - type: text
              text: "Base Money Reward | "
            - type: text
              text: @base_money_reward
        - type: panel
          layout: horizontal 
          animate:
            on_visible:
              opacity: &cascade_fade_in
          elements:
            - type: text
              text: "Turn Bonus (base bonus * extra turns) | "
            - type: text
              text: @t_bonus_mult + ' * ' + (~oMatchManager.turn_max - ~oMatchManager.turn) + ' = ' + @t_bonus
        - type: panel
          layout: horizontal 
          animate:
            on_visible:
              opacity: &cascade_fade_in
          elements:
            - type: text
              text: "Level Bonus | "
            - type: text
              text: @l_bonus
        - type: panel
          layout: horizontal 
          animate:
            on_visible:
              opacity: &cascade_fade_in
          elements:
            - type: text
              text: "Total Money Reward | "
            - type: text
              text: @total_bonus